{
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @workspace/aegis-dashboard run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://aegis-soc-dashboard-production.up.railway.app/api/:path*" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
